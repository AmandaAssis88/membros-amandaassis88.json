// Deploy do site de estudos na Cloudflare (um segundo Worker, ligado ao mesmo repositório).
// Build command:  npm run build:estudos
// Deploy command: npx wrangler deploy -c wrangler.estudos.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estudos",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "main": "./estudos/worker/index.js",
  "r2_buckets": [
    {
      "binding": "MUSICAS",
      "bucket_name": "unidunedev-musicas",
      "remote": true,
    },
  ],
  "assets": {
    "directory": "./dist-estudos",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"],
    "not_found_handling": "single-page-application",
  },
}
